{
  "name": "code-roast-website",
  "version": "1.0.0",
  "description": "A modern, responsive website for Code-Roast with data analysis and business intelligence focus",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,html}",
    "docs": "jsdoc -c jsdoc.config.json",
    "docs:serve": "serve docs/output"
  },
  "keywords": [
    "data-analysis",
    "business-intelligence",
    "website",
    "typescript",
    "vite"
  ],
  "author": "Code-Roast",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-legacy": "^5.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^12.10.0",
    "jsdoc": "^4.0.2",
    "prettier": "^3.1.0",
    "serve": "^14.2.1",
    "terser": "^5.24.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-html": "^3.2.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.3.6"
  }
}
